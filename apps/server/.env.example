# Server
DATABASE_URL="postgresql://mitaleet:mitaleet_dev@localhost:5432/mitaleet?schema=public"
JWT_SECRET="change-me-in-production-use-a-long-random-string"
# Access tokens are short-lived; clients renew them with the refresh token.
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRES_IN="30d"
PORT=3000

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"

# Firebase Admin (for FCM push notifications)
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@your-project.iam.gserviceaccount.com"

# Redis (optional — for future caching layer)
REDIS_URL="redis://localhost:6379"

# LeetCode scraping
LEETCODE_GRAPHQL_URL="https://leetcode.com/graphql"
LEETCODE_RATE_LIMIT_MS=2000
# Minimum gap between on-demand LeetCode checks for one user (extension, race, challenge)
LEETCODE_QUICK_SYNC_INTERVAL_MS=15000

# CORS
CORS_ORIGINS="http://localhost:*,capacitor://localhost,ionic://localhost"

# Local-only passwordless login (POST /auth/dev-login) for the mobile "Dev Login"
# button and tests. Ignored when NODE_ENV=production. Never set this on a server.
ENABLE_DEV_LOGIN="true"

# Environment
NODE_ENV="development"
LOG_LEVEL="debug"
